<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- SpeedometerView 可配置属性：量程三参数 -->
    <declare-styleable name="SpeedometerView">
        <attr name="maxSpeed" format="integer" />   <!-- 量程上限 km/h，默认 240 -->
        <attr name="startAngle" format="float" />   <!-- 表盘起点角，默认 135°（左下） -->
        <attr name="sweepAngle" format="float" />   <!-- 表盘扫掠角，默认 270° -->
        <attr name="touchEnabled" format="boolean" />   <!-- 调试触摸开关，默认 true -->
        <attr name="numberFontFamily" format="string" />   <!-- 数字字体族，默认 sans-serif-condensed -->
    </declare-styleable>

    <!-- TachometerView 可配置属性（Day 7）：量程三参数，与 SpeedometerView 同构 -->
    <declare-styleable name="TachometerView">
        <attr name="maxRpm" format="integer" />   <!-- 量程上限 RPM，默认 8000 -->
        <attr name="startAngle" />                <!-- 复用 SpeedometerView 已定义的 startAngle -->
        <attr name="sweepAngle" />                <!-- 复用 SpeedometerView 已定义的 sweepAngle -->
    </declare-styleable>

    <!-- TemperatureStripView 可配置属性（Day 9）：量程三步进 -->
    <declare-styleable name="TemperatureStripView">
        <attr name="minTemp" format="float" />    <!-- 最低温 ℃，默认 16 -->
        <attr name="maxTemp" format="float" />    <!-- 最高温 ℃，默认 32 -->
        <attr name="stepTemp" format="float" />   <!-- 步进 ℃，默认 0.5 -->
        <attr name="touchEnabled" />              <!-- 复用 SpeedometerView 已定义的 touchEnabled -->
    </declare-styleable>
</resources>